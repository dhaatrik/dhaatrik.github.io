---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TypographyStyles from '../../components/TypographyStyles.astro';
import { getPainLevelLabel, parseTelemetry } from '../../data/status';
import { getProjectTopology } from '../../data/projectTopology';

export async function getStaticPaths() {
    const projects = await getCollection('projects');
    return projects.map((project: CollectionEntry<'projects'>) => ({
        params: { slug: project.id.replace(/\.md$/, '') },
        props: { project },
    }));
}

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
    title,
    description,
    logo,
    githubUrl,
    progress,
    tags,
    transmissionTag: rawTransmissionTag,
    pain_level,
    fuckup_teaser,
    telemetry: telemetryStr,
} = project.data;
const { Content } = await render(project);
const [telemetryFirst, ...telemetryRestParts] = telemetryStr.split('//');
const telemetryRest = telemetryRestParts.join(' // ');
const parsed = parseTelemetry(telemetryStr);

const projectSlug = project.id.replace(/\.md$/, '');
const transmissionTag = rawTransmissionTag || projectSlug;
const topology = getProjectTopology(projectSlug);

// Generate JSON-LD SoftwareSourceCode Schema (richer than CreativeWork for GitHub projects)
const projectSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: title,
    description: description,
    inLanguage: 'en-US',
    author: {
        '@type': 'Person',
        name: 'Dhaatrik Chowdhury',
        url: 'https://dhaatrik.github.io/personnel/',
        jobTitle: 'Entrepreneur & AI Engineer',
        sameAs: [
            'https://github.com/dhaatrik',
            'https://linkedin.com/in/dhaatrik',
            'https://x.com/dhaatrik',
            'https://medium.com/@dhaatrik',
        ],
    },
    publisher: {
        '@type': 'Person',
        name: 'Dhaatrik Chowdhury',
    },
    url: new URL(Astro.url.pathname, Astro.site).href,
    image: logo ? new URL(logo.src, Astro.site).href : undefined,
    ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
    ...(githubUrl && { codeRepository: githubUrl }),
    ...(tags && tags.length > 0 && { programmingLanguage: tags }),
    runtimePlatform: 'Web Browser',
    license: 'https://opensource.org/licenses/MIT',
};
const jsonLd = JSON.stringify(projectSchema).replace(/</g, '\\u003c');

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: new URL('/', Astro.site).href,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Projects',
            item: new URL('/projects/', Astro.site).href,
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: new URL(Astro.url.pathname, Astro.site).href,
        },
    ],
};
const breadcrumbLd = JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c');

// Enrich page title with descriptive pitch for SERP snippets
const shortTagline = description.includes('—') ? description.split('—')[0].trim() : '';
const pageTitle = shortTagline ? `${title} — ${shortTagline}` : title;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={pageTitle} description={description} image={logo} />
        <TypographyStyles />
        <script is:inline type="application/ld+json" set:html={jsonLd} />
        <script is:inline type="application/ld+json" set:html={breadcrumbLd} />
    </head>
    <body class="bg-grid-motif relative flex min-h-screen flex-col pt-24">
        <div id="flashlight-bg" class="pointer-events-none fixed inset-0 z-0"></div>

        <Header />

        <main
            id="main-content"
            tabindex="-1"
            class="layout-container relative z-10 grow pt-6 pb-(--section-gap-mobile) md:pt-10 md:pb-(--section-gap-desktop)"
        >
            <article class="mx-auto w-full max-w-7xl">
                <div class="animate-fade-in mb-8">
                    <a
                        href="/projects"
                        data-astro-prefetch="hover"
                        class="magnetic-target group inline-flex items-center gap-2 rounded-lg text-sm font-medium text-slate-600 transition-all hover:text-(--accent) focus-visible:text-(--accent) focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:outline-none active:scale-95 dark:text-(--text-secondary) dark:focus-visible:ring-offset-(--bg-main)"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition-transform group-hover:-translate-x-1"
                            aria-hidden="true"
                        >
                            <path d="m15 18-6-6 6-6"></path>
                        </svg>
                        Back to Project Archive
                    </a>
                </div>

                <div class="animate-fade-in-up mb-12">
                    <div
                        class="flex flex-col gap-6 border-b border-slate-200/60 pb-8 md:flex-row md:items-center md:justify-between dark:border-white/5"
                    >
                        <div class="space-y-4">
                            <div class="flex items-center gap-2 font-mono text-xs text-(--accent)">
                                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-(--accent)"
                                ></span>
                                <span class="font-bold tracking-widest uppercase"
                                    >MISSION REPORT // {projectSlug.toUpperCase()}</span
                                >
                            </div>
                            <h1
                                class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-white"
                            >
                                {title}
                            </h1>
                            <p
                                class="text-xl leading-relaxed text-slate-600 dark:text-(--text-secondary)"
                            >
                                {description}
                            </p>
                        </div>
                        {
                            logo && (
                                <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-slate-200/50 bg-slate-50/50 p-2 shadow-xs dark:border-white/10 dark:bg-black/40">
                                    <Image
                                        src={logo}
                                        alt={`${title} Logo`}
                                        class="h-full w-full object-contain"
                                    />
                                </div>
                            )
                        }
                    </div>
                </div>

                <!-- Structured Mission Report Header Telemetry Metadata Grid -->
                <div
                    class="animate-fade-in-up relative mb-10 rounded-xl border border-slate-200/60 bg-slate-50/60 p-5 font-mono text-xs text-slate-600 shadow-xs backdrop-blur-md delay-100 dark:border-white/5 dark:bg-[#0f141f] dark:text-slate-400"
                >
                    <!-- Technical Reticle Corner Ticks -->
                    <div
                        class="pointer-events-none absolute top-0 left-0 h-2 w-2 border-t-2 border-l-2 border-(--accent)/60"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="pointer-events-none absolute top-0 right-0 h-2 w-2 border-t-2 border-r-2 border-(--accent)/60"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="pointer-events-none absolute bottom-0 left-0 h-2 w-2 border-b-2 border-l-2 border-(--accent)/60"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="pointer-events-none absolute right-0 bottom-0 h-2 w-2 border-r-2 border-b-2 border-(--accent)/60"
                        aria-hidden="true"
                    >
                    </div>

                    <div
                        class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
                    >
                        <div class="space-y-1">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // PROJECT_ID
                            </div>
                            <div
                                class="truncate font-bold text-slate-900 uppercase dark:text-slate-200"
                                title={projectSlug}
                            >
                                {projectSlug}
                            </div>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // AUTHOR
                            </div>
                            <div class="truncate font-bold text-(--accent)">DHAATRIK</div>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // LICENSE
                            </div>
                            <div class="font-bold text-slate-900 dark:text-slate-200">MIT</div>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // VERSION
                            </div>
                            <div class="truncate font-bold text-slate-900 dark:text-slate-200">
                                {progress ? progress.split(' ')[0] : 'v1.0.0'}
                            </div>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // CLASSIFICATION
                            </div>
                            <div class="font-bold text-emerald-600 uppercase dark:text-emerald-400">
                                OPEN // PUBLIC
                            </div>
                        </div>
                        {
                            pain_level && (
                                <div class="space-y-1">
                                    <div class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400">
                                        // IMPACT.LOG
                                    </div>
                                    <div
                                        role="meter"
                                        aria-label={`Impact level: ${pain_level} out of 5`}
                                        aria-valuetext={getPainLevelLabel(pain_level)}
                                        aria-valuenow={pain_level}
                                        aria-valuemin={1}
                                        aria-valuemax={5}
                                        class="mt-1 flex items-center gap-1"
                                    >
                                        {[1, 2, 3, 4, 5].map((i) => {
                                            const colors: { [key: number]: string } = {
                                                1: 'bg-[#8b5cf6] shadow-[0_0_6px_rgba(139,92,246,0.5)]',
                                                2: 'bg-[#10b981] shadow-[0_0_6px_rgba(16,185,129,0.5)]',
                                                3: 'bg-[#eab308] shadow-[0_0_6px_rgba(234,179,8,0.5)]',
                                                4: 'bg-[#f97316] shadow-[0_0_6px_rgba(249,115,22,0.5)]',
                                                5: 'bg-[#ef4444] shadow-[0_0_6px_rgba(239,68,68,0.5)]',
                                            };
                                            const activeColor =
                                                colors[pain_level ?? 1] ?? 'bg-(--accent)';
                                            return (
                                                <span
                                                    aria-hidden="true"
                                                    class={`h-1.5 w-3 rounded-xs transition-all duration-300 ${
                                                        i <= (pain_level ?? 0)
                                                            ? `${activeColor} opacity-90`
                                                            : 'bg-slate-200 opacity-40 dark:bg-white/10'
                                                    }`}
                                                />
                                            );
                                        })}
                                    </div>
                                </div>
                            )
                        }

                        {
                            /* STACK: Spans 2 cols on mobile/tablet and 3 cols on large displays for zero truncation */
                        }
                        <div class="col-span-2 space-y-1.5 sm:col-span-3 lg:col-span-3">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // STACK
                            </div>
                            <div class="flex flex-wrap items-center gap-1.5">
                                {
                                    tags && tags.length > 0 ? (
                                        tags
                                            .slice(0, 4)
                                            .map((tag: string) => (
                                                <span class="rounded border border-slate-200/80 bg-white/70 px-2 py-0.5 font-mono text-[10px] font-medium text-slate-700 shadow-2xs dark:border-white/10 dark:bg-white/5 dark:text-slate-200">
                                                    {tag}
                                                </span>
                                            ))
                                    ) : (
                                        <span class="font-bold text-slate-900 dark:text-slate-200">
                                            TypeScript
                                        </span>
                                    )
                                }
                            </div>
                        </div>

                        {
                            /* TELEMETRY: Spans 2 cols on mobile/tablet and 3 cols on large displays for zero truncation */
                        }
                        <div class="col-span-2 space-y-1.5 sm:col-span-3 lg:col-span-3">
                            <div
                                class="text-[9px] font-bold tracking-widest text-slate-500 uppercase dark:text-slate-400"
                            >
                                // TELEMETRY
                            </div>
                            <div>
                                <span
                                    class="inline-flex max-w-full items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[9px] font-bold tracking-widest text-emerald-600 uppercase shadow-2xs sm:text-[10px] dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-300"
                                >
                                    <span
                                        class={`h-1.5 w-1.5 shrink-0 rounded-full ${parsed.colorClass} shadow-[0_0_8px_rgba(16,185,129,0.5)]`}
                                    ></span>
                                    <span class="truncate">
                                        <span>{telemetryFirst.trim()}</span>
                                        {
                                            telemetryRest && (
                                                <span class="opacity-80">
                                                    {' '}
                                                    // {telemetryRest.trim()}
                                                </span>
                                            )
                                        }
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Responsive Project Architecture Schematic Topology -->
                <div
                    class="mb-12 overflow-hidden rounded-xl border border-slate-200/80 bg-slate-900/95 p-5 text-white shadow-inner backdrop-blur-md dark:border-white/10 dark:bg-black/70"
                >
                    <div
                        class="mb-4 flex flex-wrap items-center justify-between gap-2 font-mono text-[10px]"
                    >
                        <div class="flex items-center gap-2">
                            <span
                                class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"
                            ></span>
                            <span class="font-bold tracking-widest text-slate-300 uppercase">
                                SYSTEM_TOPOLOGY // {topology.systemType}
                            </span>
                        </div>
                        <span
                            class="rounded border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-0.5 font-bold tracking-widest text-cyan-400 uppercase"
                        >
                            {topology.boundaryBadge}
                        </span>
                    </div>

                    <div
                        class="flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-between"
                    >
                        {/* Node 1: Surface / UI Layer */}
                        <div
                            class="relative flex-1 rounded-lg border border-sky-500/30 bg-sky-500/5 p-4 transition-colors hover:border-sky-500/50 hover:bg-sky-500/10 dark:border-sky-400/25 dark:bg-sky-400/5"
                        >
                            <div class="mb-1.5 flex items-center justify-between">
                                <span
                                    class="font-mono text-[9px] font-bold tracking-widest text-sky-400 uppercase"
                                >
                                    // 01 // {topology.nodes[0].layer}
                                </span>
                                <span
                                    class="rounded bg-sky-500/20 px-1.5 py-0.5 font-mono text-[8px] font-bold text-sky-300 uppercase"
                                >
                                    {topology.nodes[0].badge}
                                </span>
                            </div>
                            <div class="font-mono text-sm font-bold tracking-tight text-white">
                                {topology.nodes[0].title}
                            </div>
                            <div class="mt-1 font-mono text-xs text-slate-400">
                                {topology.nodes[0].detail}
                            </div>
                        </div>

                        {/* Connector 1 */}
                        <div
                            class="flex shrink-0 items-center justify-center py-1 text-slate-500 md:py-0"
                        >
                            <svg
                                class="hidden h-5 w-8 text-sky-400/70 md:block"
                                viewBox="0 0 32 20"
                                fill="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="0"
                                    y1="10"
                                    x2="24"
                                    y2="10"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="3 3"></line>
                                <polygon points="24,6 30,10 24,14" fill="currentColor"></polygon>
                            </svg>
                            <svg
                                class="h-5 w-5 text-sky-400/70 md:hidden"
                                viewBox="0 0 20 20"
                                fill="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="10"
                                    y1="0"
                                    x2="10"
                                    y2="14"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="3 3"></line>
                                <polygon points="6,14 10,20 14,14" fill="currentColor"></polygon>
                            </svg>
                        </div>

                        {/* Node 2: Engine / Core Layer */}
                        <div
                            class="relative flex-1 rounded-lg border border-indigo-500/30 bg-indigo-500/5 p-4 transition-colors hover:border-indigo-500/50 hover:bg-indigo-500/10 dark:border-indigo-400/25 dark:bg-indigo-400/5"
                        >
                            <div class="mb-1.5 flex items-center justify-between">
                                <span
                                    class="font-mono text-[9px] font-bold tracking-widest text-indigo-400 uppercase"
                                >
                                    // 02 // {topology.nodes[1].layer}
                                </span>
                                <span
                                    class="rounded bg-indigo-500/20 px-1.5 py-0.5 font-mono text-[8px] font-bold text-indigo-300 uppercase"
                                >
                                    {topology.nodes[1].badge}
                                </span>
                            </div>
                            <div class="font-mono text-sm font-bold tracking-tight text-white">
                                {topology.nodes[1].title}
                            </div>
                            <div class="mt-1 font-mono text-xs text-slate-400">
                                {topology.nodes[1].detail}
                            </div>
                        </div>

                        {/* Connector 2 */}
                        <div
                            class="flex shrink-0 items-center justify-center py-1 text-slate-500 md:py-0"
                        >
                            <svg
                                class="hidden h-5 w-8 text-indigo-400/70 md:block"
                                viewBox="0 0 32 20"
                                fill="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="0"
                                    y1="10"
                                    x2="24"
                                    y2="10"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="3 3"></line>
                                <polygon points="24,6 30,10 24,14" fill="currentColor"></polygon>
                            </svg>
                            <svg
                                class="h-5 w-5 text-indigo-400/70 md:hidden"
                                viewBox="0 0 20 20"
                                fill="none"
                                aria-hidden="true"
                            >
                                <line
                                    x1="10"
                                    y1="0"
                                    x2="10"
                                    y2="14"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-dasharray="3 3"></line>
                                <polygon points="6,14 10,20 14,14" fill="currentColor"></polygon>
                            </svg>
                        </div>

                        {/* Node 3: Boundary / Storage Layer */}
                        <div
                            class="relative flex-1 rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-4 transition-colors hover:border-emerald-500/50 hover:bg-emerald-500/10 dark:border-emerald-400/25 dark:bg-emerald-400/5"
                        >
                            <div class="mb-1.5 flex items-center justify-between">
                                <span
                                    class="font-mono text-[9px] font-bold tracking-widest text-emerald-400 uppercase"
                                >
                                    // 03 // {topology.nodes[2].layer}
                                </span>
                                <span
                                    class="rounded bg-emerald-500/20 px-1.5 py-0.5 font-mono text-[8px] font-bold text-emerald-300 uppercase"
                                >
                                    {topology.nodes[2].badge}
                                </span>
                            </div>
                            <div class="font-mono text-sm font-bold tracking-tight text-white">
                                {topology.nodes[2].title}
                            </div>
                            <div class="mt-1 font-mono text-xs text-slate-400">
                                {topology.nodes[2].detail}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_280px]">
                    <div class="w-full min-w-0">
                        {
                            fuckup_teaser && (
                                <div
                                    class="mb-8 rounded-xl border border-red-500/25 bg-red-500/5 p-4 backdrop-blur-xs dark:border-red-500/20 dark:bg-red-950/20"
                                    role="note"
                                    aria-label="Honest failure reflection"
                                >
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="h-2 w-2 animate-pulse rounded-full bg-red-500" />
                                        <span class="font-mono text-xs font-bold tracking-widest text-red-500 uppercase dark:text-red-400">
                                            // FAULT_ANALYSIS // LESSONS_LEARNED
                                        </span>
                                    </div>
                                    <p class="font-mono text-xs leading-relaxed text-red-800 dark:text-red-200">
                                        "{fuckup_teaser}"
                                    </p>
                                </div>
                            )
                        }
                        <div
                            class="prose prose-slate dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-a:text-(--accent) prose-strong:text-slate-900 dark:prose-strong:text-white prose-pre:bg-slate-900 dark:prose-pre:bg-[#0b0e14] prose-pre:border prose-pre:border-slate-800 animate-fade-in-up max-w-none delay-200"
                        >
                            <Content />
                        </div>
                    </div>

                    <aside
                        aria-label="Project details and repository links"
                        class="animate-fade-in-up space-y-8 delay-300 lg:sticky lg:top-28"
                    >
                        {
                            githubUrl && (
                                <div class="glass-surface rounded-xl p-5">
                                    <h3 class="mb-3 font-mono text-[10px] font-bold tracking-widest text-slate-600 uppercase dark:text-slate-400">
                                        // REPOSITORY
                                    </h3>
                                    <a
                                        href={githubUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`Inspect ${title} repository on GitHub (opens in a new tab)`}
                                        class="magnetic-target inline-flex w-full items-center justify-center gap-2 rounded-lg bg-(--accent-button-bg) px-4 py-2.5 text-center font-mono text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all hover:bg-blue-600 focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:outline-none active:scale-95 dark:focus-visible:ring-offset-(--bg-main)"
                                    >
                                        Inspect Repository
                                    </a>
                                </div>
                            )
                        }

                        <div class="glass-surface rounded-xl p-5">
                            <h3
                                class="mb-3 font-mono text-[10px] font-bold tracking-widest text-slate-600 uppercase dark:text-slate-400"
                            >
                                // TRANSMISSIONS
                            </h3>
                            <a
                                href={`/transmissions?tag=${transmissionTag}`}
                                class="magnetic-target inline-flex w-full items-center justify-center gap-2 rounded-lg border border-(--accent)/30 bg-(--accent)/5 px-4 py-2.5 text-center font-mono text-xs font-bold tracking-wider text-(--accent) uppercase shadow-xs transition-all hover:bg-(--accent)/15 focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:outline-none active:scale-95 dark:focus-visible:ring-offset-(--bg-main)"
                            >
                                Read Mission Logs
                            </a>
                        </div>

                        <div class="glass-surface rounded-xl p-5">
                            <h3
                                class="mb-3 font-mono text-[10px] font-bold tracking-widest text-slate-600 uppercase dark:text-slate-400"
                            >
                                // CURRENT_STATUS
                            </h3>
                            <p class="font-mono text-xs text-slate-700 dark:text-slate-300">
                                {progress}
                            </p>
                        </div>

                        {
                            tags && tags.length > 0 && (
                                <div class="glass-surface rounded-xl p-5">
                                    <h3 class="mb-4 font-mono text-[10px] font-bold tracking-widest text-slate-600 uppercase dark:text-slate-400">
                                        // STACK
                                    </h3>
                                    <div class="flex flex-wrap gap-2">
                                        {tags.map((tag: string) => (
                                            <span class="rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-[10px] text-slate-600 dark:border-white/5 dark:bg-white/5 dark:text-(--text-secondary)">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            )
                        }
                    </aside>
                </div>
            </article>
        </main>

        <Footer />
    </body>
</html>
