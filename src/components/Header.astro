---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, '');
const displayPath = cleanPath === '' ? '~/home' : `~/home${cleanPath}`;

/** Compact breadcrumb for tight header slots — keeps terminal vibe without wrapping nav. */
function formatHeaderPath(path: string): string {
    if (path.length <= 34) return path;

    const segments = path
        .replace(/^~\/home\/?/, '')
        .split('/')
        .filter(Boolean);
    if (segments.length === 0) return '~/home';
    if (segments.length === 1) return `~/home/${segments[0]}`;

    const tail = segments[segments.length - 1];
    const compact = `~/…/${tail}`;
    return compact.length <= 34 ? compact : `~/…/${tail.slice(0, 22)}…`;
}
const displayPathShort = formatHeaderPath(displayPath);
---

<style>
    @keyframes sonar {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }
        100% {
            transform: scale(2.5);
            opacity: 0;
        }
    }
    .sonar-icon {
        position: relative;
        overflow: visible;
        isolation: isolate;
    }
    .sonar-trigger {
        overflow: visible;
    }
    .sonar-icon::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        border-radius: 50%;
        background-color: var(--accent);
        opacity: 0;
        z-index: -1;
        pointer-events: none;
    }
    .sonar-trigger:hover .sonar-icon::after {
        animation: sonar 1s cubic-bezier(0, 0.2, 0.8, 1) forwards;
    }

    /* Ensure the header transition is smooth for the hide/show effect and promoted to GPU */
    #main-header {
        will-change: transform;
        transition:
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.3s ease,
            border-color 0.3s ease,
            backdrop-filter 0.3s ease,
            -webkit-backdrop-filter 0.3s ease,
            box-shadow 0.3s ease;
    }

    /* Hamburger Line Animations */
    .hamburger-line {
        transition:
            transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
            opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.3s ease;
    }
    #mobile-nav-toggle.open .hamburger-line:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    #mobile-nav-toggle.open .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: scale(0);
    }
    #mobile-nav-toggle.open .hamburger-line:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    /* Mobile Nav Drawer Premium Animations */
    #mobile-nav-drawer {
        display: none;
        opacity: 0;
        transition:
            transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            display 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        transition-behavior: allow-discrete;
    }

    #mobile-nav-drawer.translate-x-0 {
        display: flex;
        opacity: 1;
    }

    @starting-style {
        #mobile-nav-drawer.translate-x-0 {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    #mobile-nav-backdrop {
        display: none;
        opacity: 0;
        transition:
            opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            display 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        transition-behavior: allow-discrete;
    }

    #mobile-nav-backdrop.opacity-100 {
        display: block;
        opacity: 1;
    }

    @starting-style {
        #mobile-nav-backdrop.opacity-100 {
            opacity: 0;
        }
    }

    /* Staggered items animation when drawer is open */
    #mobile-nav-drawer .drawer-item {
        opacity: 0;
        transform: translateX(16px);
        transition:
            opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
            background-color 0.3s ease,
            color 0.3s ease;
    }

    #mobile-nav-drawer.open .drawer-item {
        opacity: 1;
        transform: translateX(0);
    }

    #mobile-nav-drawer.open .drawer-item:nth-child(1) {
        transition-delay: 0.08s;
    }
    #mobile-nav-drawer.open .drawer-item:nth-child(2) {
        transition-delay: 0.12s;
    }
    #mobile-nav-drawer.open .drawer-item:nth-child(3) {
        transition-delay: 0.16s;
    }
    #mobile-nav-drawer.open .drawer-item:nth-child(4) {
        transition-delay: 0.2s;
    }
    #mobile-nav-drawer.open .drawer-item:nth-child(5) {
        transition-delay: 0.24s;
    }
    #mobile-nav-drawer.open .drawer-item:nth-child(6) {
        transition-delay: 0.28s;
    }

    #mobile-nav-drawer .drawer-telemetry {
        opacity: 0;
        transform: translateY(12px);
        transition:
            opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #mobile-nav-drawer.open .drawer-telemetry {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.32s;
    }

    @media (prefers-reduced-motion: reduce) {
        #mobile-nav-drawer {
            transition: none;
        }
        #mobile-nav-backdrop {
            transition: none;
        }
        #mobile-nav-drawer .drawer-item {
            opacity: 1;
            transform: none;
            transition: none;
            transition-delay: 0s !important;
        }
        #mobile-nav-drawer .drawer-telemetry {
            opacity: 1;
            transform: none;
            transition: none;
            transition-delay: 0s !important;
        }
        .hamburger-line {
            transition: none;
        }
    }

    /* Prevent long route breadcrumbs from pushing nav controls to a new line */
    #main-nav {
        flex-wrap: nowrap;
    }

    #header-brand {
        min-width: 0;
        overflow: visible;
    }

    #header-brand-copy {
        min-width: 0;
        overflow: visible;
    }

    #header-brand-path {
        display: block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @media (min-width: 768px) {
        #header-brand-path {
            max-width: min(28vw, 16rem);
        }
    }

    @media (min-width: 1024px) {
        #header-brand-path {
            max-width: min(22vw, 18rem);
        }
    }

    @media (min-width: 1280px) {
        #header-brand-path {
            max-width: min(26vw, 22rem);
        }
    }

    @supports (anchor-name: --x) {
        .desktop-nav-links {
            position: relative;
        }
        .desktop-nav-links a {
            position: relative;
            z-index: 10;
        }
        .desktop-nav-links a:hover,
        .desktop-nav-links a:focus-visible {
            anchor-name: --nav-active;
        }
        .desktop-nav-links::before {
            content: '';
            position: absolute;
            position-anchor: --nav-active;
            top: anchor(top);
            bottom: anchor(bottom);
            left: anchor(left);
            right: anchor(right);

            margin: -0.25rem -0.5rem;

            border-radius: 0.375rem;
            background-color: color-mix(in srgb, var(--accent) 8%, transparent);

            opacity: 0;
            pointer-events: none;
            z-index: 0;

            @media (prefers-reduced-motion: no-preference) {
                transition:
                    top 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    bottom 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    left 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    right 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.2s ease;
            }
            @media (prefers-reduced-motion: reduce) {
                transition: opacity 0.2s ease;
            }
        }
        .desktop-nav-links:has(a:hover)::before,
        .desktop-nav-links:has(a:focus-visible)::before {
            opacity: 1;
        }
    }
</style>

<!-- Subtle Noise Texture -->
<div
    class="pointer-events-none fixed inset-0 z-100 h-full w-full opacity-[0.03] mix-blend-overlay"
    style="background-image: url('data:image/svg+xml;base64,');"
>
</div>
<!-- Ambient Background Glows -->
<div
    class="pointer-events-none fixed -top-[20%] -left-[10%] -z-10 h-[50vw] w-[50vw] rounded-full bg-(--accent)/20 mix-blend-multiply blur-[120px] dark:bg-(--accent)/10 dark:mix-blend-screen"
>
</div>
<div
    class="pointer-events-none fixed -right-[10%] -bottom-[20%] -z-10 h-[50vw] w-[50vw] rounded-full bg-purple-500/20 mix-blend-multiply blur-[120px] dark:bg-purple-500/10 dark:mix-blend-screen"
>
</div>

<a
    href="#main-content"
    aria-label="Skip to main content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-100 focus:bg-(--accent) focus:px-4 focus:py-2 focus:font-bold focus:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 dark:focus-visible:ring-offset-(--bg-main)"
>
    Skip to content
</a>

<header id="main-header" class="glass-surface glass-chrome fixed top-0 z-50 w-full">
    <nav
        id="main-nav"
        class="layout-container flex items-center justify-between gap-3 py-4 transition-colors duration-300 ease-in-out"
    >
        {
            /* Enable hover prefetching for isolated internal links to provide instant page transitions */
        }
        <a
            id="header-brand"
            href="/"
            data-astro-prefetch="hover"
            class="sonar-trigger group flex min-w-0 items-center transition-opacity hover:opacity-80 focus-visible:opacity-80"
            aria-label="Dhaatrik — Home"
        >
            <div class="sonar-icon shrink-0 rounded-full">
                <img
                    src="/logo_dark.svg"
                    alt="Dhaatrik Logo"
                    class="relative z-10 h-10 w-10 sm:h-12 sm:w-12 dark:hidden"
                    width="48"
                    height="48"
                />
                <img
                    src="/logo_light.svg"
                    alt="Dhaatrik Logo"
                    class="relative z-10 hidden h-10 w-10 sm:h-12 sm:w-12 dark:block"
                    width="48"
                    height="48"
                />
            </div>

            <div id="header-brand-copy" class="flex min-w-0 items-center">
                <div
                    class="mx-3 h-6 shrink-0 border-l border-slate-300 transition-colors group-hover:border-(--accent)/50 dark:border-white/20"
                >
                </div>
                <div class="flex min-w-0 flex-col justify-center">
                    <span
                        class="flex shrink-0 items-center gap-1.5 leading-none font-bold tracking-tight whitespace-nowrap text-slate-900 dark:text-white"
                    >
                        DHAATRIK
                        <span class="relative flex h-1.5 w-1.5">
                            <span
                                class="animate-pulse-emerald absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"
                            ></span>
                        </span>
                    </span>
                    <span
                        id="header-brand-path"
                        class="mt-1 hidden font-mono text-[10px] leading-none tracking-widest text-(--accent) opacity-80 sm:block"
                        title={displayPath}>{displayPathShort}</span
                    >
                </div>
            </div>
        </a>
        <div class="flex shrink-0 items-center gap-2.5 sm:gap-4 md:gap-6">
            <div class="desktop-nav-links hidden items-center gap-5 md:flex lg:gap-6">
                <HeaderLink
                    href="/"
                    data-nav-key="1"
                    title="Home [Press 1]"
                    class="group/link flex items-center text-xs font-semibold tracking-widest text-slate-600 uppercase transition-colors hover:text-(--accent) focus-visible:text-(--accent) dark:text-(--text-secondary)"
                >
                    <span
                        aria-hidden="true"
                        class="mr-1.5 font-mono text-[10px] text-slate-400 opacity-70 transition-colors group-hover/link:text-(--accent) dark:text-slate-500"
                        >[ 01 ]</span
                    >Home
                </HeaderLink>
                <HeaderLink
                    href="/personnel"
                    data-nav-key="2"
                    title="Personnel [Press 2]"
                    class="group/link flex items-center text-xs font-semibold tracking-widest text-slate-600 uppercase transition-colors hover:text-(--accent) focus-visible:text-(--accent) dark:text-(--text-secondary)"
                >
                    <span
                        aria-hidden="true"
                        class="mr-1.5 font-mono text-[10px] text-slate-400 opacity-70 transition-colors group-hover/link:text-(--accent) dark:text-slate-500"
                        >[ 02 ]</span
                    >Personnel
                </HeaderLink>
                <HeaderLink
                    href="/projects"
                    data-nav-key="3"
                    title="Projects [Press 3]"
                    class="group/link flex items-center text-xs font-semibold tracking-widest text-slate-600 uppercase transition-colors hover:text-(--accent) focus-visible:text-(--accent) dark:text-(--text-secondary)"
                >
                    <span
                        aria-hidden="true"
                        class="mr-1.5 font-mono text-[10px] text-slate-400 opacity-70 transition-colors group-hover/link:text-(--accent) dark:text-slate-500"
                        >[ 03 ]</span
                    >Projects
                </HeaderLink>
                <HeaderLink
                    href="/pedagogy"
                    data-nav-key="4"
                    title="Pedagogy [Press 4]"
                    class="group/link flex items-center text-xs font-semibold tracking-widest text-slate-600 uppercase transition-colors hover:text-(--accent) focus-visible:text-(--accent) dark:text-(--text-secondary)"
                >
                    <span
                        aria-hidden="true"
                        class="mr-1.5 font-mono text-[10px] text-slate-400 opacity-70 transition-colors group-hover/link:text-(--accent) dark:text-slate-500"
                        >[ 04 ]</span
                    >Pedagogy
                </HeaderLink>
                <HeaderLink
                    href="/transmissions"
                    data-nav-key="5"
                    title="Transmissions [Press 5]"
                    class="group/link flex items-center text-xs font-semibold tracking-widest text-slate-600 uppercase transition-colors hover:text-(--accent) focus-visible:text-(--accent) dark:text-(--text-secondary)"
                >
                    <span
                        aria-hidden="true"
                        class="mr-1.5 font-mono text-[10px] text-slate-400 opacity-70 transition-colors group-hover/link:text-(--accent) dark:text-slate-500"
                        >[ 05 ]</span
                    >Transmissions
                </HeaderLink>
            </div>
            <ThemeToggle />
            <button
                id="mobile-nav-toggle"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
                aria-controls="mobile-nav-drawer"
                class="magnetic-target relative z-50 flex h-11 min-h-11 w-11 min-w-11 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-full border border-transparent transition-colors hover:bg-slate-200/60 hover:text-slate-900 focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 md:hidden dark:hover:bg-white/10 dark:hover:text-white dark:focus-visible:ring-offset-(--bg-main)"
            >
                <span class="hamburger-line h-0.5 w-5 bg-current"></span>
                <span class="hamburger-line h-0.5 w-5 bg-current"></span>
                <span class="hamburger-line h-0.5 w-5 bg-current"></span>
            </button>
        </div>
    </nav>
</header>

<div
    id="mobile-nav-backdrop"
    class="pointer-events-none fixed inset-0 z-40 bg-slate-950/40 opacity-0 backdrop-blur-md md:hidden"
    aria-hidden="true"
>
</div>

<nav
    id="mobile-nav-drawer"
    class="glass-surface glass-drawer fixed top-0 right-0 z-40 flex h-full w-72 translate-x-full flex-col gap-6 overscroll-contain p-6 pt-[calc(5.5rem+env(safe-area-inset-top,0px))] pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] md:hidden"
    aria-label="Mobile navigation"
>
    <!-- Decorative Grid Motif -->
    <div
        class="bg-grid-motif pointer-events-none absolute inset-0 opacity-[0.02] dark:opacity-[0.04]"
    >
    </div>

    <div class="relative z-10 flex flex-col gap-3 font-mono">
        <div
            class="drawer-item mb-2 border-b border-slate-200/50 pb-2 text-[9px] tracking-widest text-slate-400 uppercase dark:border-white/5 dark:text-slate-500"
        >
            // DIRECTORY_INDEX
        </div>

        {
            [
                {
                    href: '/',
                    label: 'Home',
                    key: '1',
                    index: '[ 01 ]',
                    isActive: cleanPath === '' || cleanPath === '/',
                },
                {
                    href: '/personnel',
                    label: 'Personnel',
                    key: '2',
                    index: '[ 02 ]',
                    isActive: cleanPath.startsWith('/personnel'),
                },
                {
                    href: '/projects',
                    label: 'Projects',
                    key: '3',
                    index: '[ 03 ]',
                    isActive: cleanPath.startsWith('/projects'),
                },
                {
                    href: '/pedagogy',
                    label: 'Pedagogy',
                    key: '4',
                    index: '[ 04 ]',
                    isActive: cleanPath.startsWith('/pedagogy'),
                },
                {
                    href: '/transmissions',
                    label: 'Transmissions',
                    key: '5',
                    index: '[ 05 ]',
                    isActive: cleanPath.startsWith('/transmissions'),
                },
            ].map((item) => (
                <a
                    href={item.href}
                    data-nav-key={item.key}
                    data-astro-prefetch="hover"
                    class:list={[
                        'drawer-item group/link relative flex items-center justify-between rounded-lg px-3.5 py-2.5 text-sm outline-none focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 dark:focus-visible:ring-offset-[#0b0e14]',
                        item.isActive
                            ? 'bg-(--accent)/10 font-semibold text-(--accent) dark:bg-(--accent)/15'
                            : 'text-slate-700 hover:bg-slate-100/50 hover:text-(--accent) focus-visible:bg-slate-100/50 focus-visible:text-(--accent) dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white',
                    ]}
                >
                    {item.isActive && (
                        <span class="absolute top-2 bottom-2 left-0 w-1 rounded-r-md bg-(--accent) shadow-[0_0_8px_var(--accent)]" />
                    )}
                    <div class="flex items-center gap-3 transition-transform duration-300 group-hover/link:translate-x-1 group-focus-visible/link:translate-x-1">
                        <span
                            class:list={[
                                'text-[10px] transition-colors',
                                item.isActive
                                    ? 'text-(--accent)'
                                    : 'text-slate-400 group-hover/link:text-(--accent) group-focus-visible/link:text-(--accent) dark:text-slate-500',
                            ]}
                        >
                            {item.index}
                        </span>
                        <span class="text-xs font-semibold tracking-widest uppercase">
                            {item.label}
                        </span>
                    </div>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class:list={[
                            'transition-transform duration-300',
                            item.isActive
                                ? 'translate-x-0 text-(--accent)'
                                : '-translate-x-2 text-slate-400 opacity-0 group-hover/link:translate-x-0 group-hover/link:opacity-100 group-focus-visible/link:translate-x-0 group-focus-visible/link:opacity-100 dark:text-slate-600',
                        ]}
                    >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            ))
        }
    </div>

    <!-- Telemetry sci-fi panel in footer -->
    <div
        class="drawer-telemetry relative z-10 mt-auto flex flex-col gap-4 border-t border-slate-200/60 pt-5 font-mono text-[10px] text-slate-500 dark:border-white/10 dark:text-slate-400"
    >
        <div class="flex items-center justify-between">
            <span class="text-[9px] tracking-wider text-slate-400 uppercase dark:text-slate-500"
                >SYS.STATUS</span
            >
            <div
                class="flex items-center gap-1.5 font-semibold text-emerald-600 dark:text-emerald-400"
            >
                <span class="relative flex h-1.5 w-1.5">
                    <span
                        class="animate-pulse-emerald absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"
                    ></span>
                </span>
                <span class="text-[9px] tracking-widest uppercase">ACTIVE</span>
            </div>
        </div>

        <div
            class="grid grid-cols-2 gap-2 border-t border-dashed border-slate-200/60 pt-3 dark:border-white/5"
        >
            <div class="flex flex-col gap-0.5">
                <span class="text-[8px] tracking-wider text-slate-400 uppercase dark:text-slate-500"
                    >SYS.CORES</span
                >
                <span id="drawer-sys-cores" class="font-semibold text-slate-700 dark:text-slate-300"
                    >—</span
                >
            </div>
            <div class="flex flex-col gap-0.5">
                <span class="text-[8px] tracking-wider text-slate-400 uppercase dark:text-slate-500"
                    >SYS.RTT</span
                >
                <span id="drawer-sys-rtt" class="font-semibold text-slate-700 dark:text-slate-300"
                    >—</span
                >
            </div>
        </div>

        <div
            class="flex flex-col gap-1 border-t border-dashed border-slate-200/60 pt-3 dark:border-white/5"
        >
            <span class="text-[9px] tracking-wider text-slate-400 uppercase dark:text-slate-500"
                >SYS.LOCATION</span
            >
            <span
                id="mobile-telemetry-path"
                class="truncate leading-none font-semibold tracking-wide text-(--accent) lowercase"
            >
                {displayPath}
            </span>
        </div>

        <div
            class="flex items-center justify-between border-t border-slate-200/60 pt-3 text-[9px] tracking-wider text-slate-400 dark:border-white/10 dark:text-slate-500"
        >
            <span>SWIPE RIGHT TO CLOSE</span>
            <span>[ ESC ]</span>
        </div>
    </div>
</nav>

<script src="../scripts/header.ts"></script>
