---

---

<div
    id="reticle-bg"
    class="pointer-events-none absolute top-12 right-0 -z-10 text-slate-900 opacity-5 transition-transform duration-300 ease-out md:top-16 dark:text-white"
>
    <svg width="400" height="400" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid Dots (Blueprint style) -->
        <path
            d="M 20 20 L 20 180 L 180 180 L 180 20 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 19"
            opacity="0.3"></path>
        <path
            d="M 40 20 L 40 180 M 60 20 L 60 180 M 80 20 L 80 180 M 120 20 L 120 180 M 140 20 L 140 180 M 160 20 L 160 180"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 9"
            opacity="0.15"></path>
        <path
            d="M 20 40 L 180 40 M 20 60 L 180 60 M 20 80 L 180 80 M 20 120 L 180 120 M 20 140 L 180 140 M 20 160 L 180 160"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 9"
            opacity="0.15"></path>

        <!-- Concentric dashed calibration circles -->
        <circle
            cx="100"
            cy="100"
            r="90"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="2 8"
            opacity="0.4"></circle>
        <circle
            cx="100"
            cy="100"
            r="80"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="3 3"></circle>
        <circle
            cx="100"
            cy="100"
            r="60"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="6 6"></circle>
        <circle
            cx="100"
            cy="100"
            r="30"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 3"
            opacity="0.5"></circle>

        <!-- Calibration axes -->
        <line
            x1="10"
            y1="100"
            x2="190"
            y2="100"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="2 4"></line>
        <line
            x1="100"
            y1="10"
            x2="100"
            y2="190"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="2 4"></line>

        <!-- Compass Ticks -->
        <line x1="100" y1="10" x2="100" y2="15" stroke="currentColor" stroke-width="1"></line>
        <line x1="100" y1="185" x2="100" y2="190" stroke="currentColor" stroke-width="1"></line>
        <line x1="10" y1="100" x2="15" y2="100" stroke="currentColor" stroke-width="1"></line>
        <line x1="185" y1="100" x2="190" y2="100" stroke="currentColor" stroke-width="1"></line>

        <!-- Outer diamond projection bounds -->
        <path
            d="M 100 20 L 180 100 L 100 180 L 20 100 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 5"></path>

        <slot />
    </svg>
</div>
