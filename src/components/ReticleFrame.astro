---
interface Props {
    class?: string;
    id?: string;
}

const { class: className = '', id = 'reticle-bg' } = Astro.props;
---

<div
    id={id}
    class={`pointer-events-none absolute -z-10 text-slate-900 opacity-10 transition-transform duration-300 ease-out md:opacity-15 dark:text-white dark:opacity-20 ${className || 'top-12 right-0 md:top-16'}`}
    aria-hidden="true"
>
    <svg width="400" height="400" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <!-- Background Grid Dots (Blueprint style) -->
        <path
            d="M 20 20 L 20 180 L 180 180 L 180 20 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 19"
            opacity="0.35"></path>
        <path
            d="M 40 20 L 40 180 M 60 20 L 60 180 M 80 20 L 80 180 M 120 20 L 120 180 M 140 20 L 140 180 M 160 20 L 160 180"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 9"
            opacity="0.18"></path>
        <path
            d="M 20 40 L 180 40 M 20 60 L 180 60 M 20 80 L 180 80 M 20 120 L 180 120 M 20 140 L 180 140 M 20 160 L 180 160"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 9"
            opacity="0.18"></path>

        <!-- Concentric dashed calibration circles -->
        <circle
            cx="100"
            cy="100"
            r="92"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="2 8"
            opacity="0.45"></circle>
        <circle
            cx="100"
            cy="100"
            r="80"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="3 3"
            opacity="0.6"></circle>
        <circle
            cx="100"
            cy="100"
            r="60"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="6 6"
            opacity="0.7"></circle>
        <circle
            cx="100"
            cy="100"
            r="30"
            fill="none"
            stroke="currentColor"
            stroke-width="0.4"
            stroke-dasharray="1 3"
            opacity="0.6"></circle>
        <circle
            cx="100"
            cy="100"
            r="8"
            fill="none"
            stroke="currentColor"
            stroke-width="0.6"
            opacity="0.8"></circle>

        <!-- Calibration axes -->
        <line
            x1="10"
            y1="100"
            x2="190"
            y2="100"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="2 4"></line>
        <line
            x1="100"
            y1="10"
            x2="100"
            y2="190"
            stroke="currentColor"
            stroke-width="0.5"
            stroke-dasharray="2 4"></line>

        <!-- Compass Cardinal Ticks -->
        <line x1="100" y1="8" x2="100" y2="16" stroke="currentColor" stroke-width="0.8"></line>
        <line x1="100" y1="184" x2="100" y2="192" stroke="currentColor" stroke-width="0.8"></line>
        <line x1="8" y1="100" x2="16" y2="100" stroke="currentColor" stroke-width="0.8"></line>
        <line x1="184" y1="100" x2="192" y2="100" stroke="currentColor" stroke-width="0.8"></line>

        <!-- Degree Markings -->
        <text
            x="100"
            y="6"
            text-anchor="middle"
            font-family="monospace"
            font-size="3"
            fill="currentColor"
            opacity="0.65">000°</text
        >
        <text
            x="195"
            y="101"
            text-anchor="start"
            font-family="monospace"
            font-size="3"
            fill="currentColor"
            opacity="0.65">090°</text
        >
        <text
            x="100"
            y="197"
            text-anchor="middle"
            font-family="monospace"
            font-size="3"
            fill="currentColor"
            opacity="0.65">180°</text
        >
        <text
            x="5"
            y="101"
            text-anchor="end"
            font-family="monospace"
            font-size="3"
            fill="currentColor"
            opacity="0.65">270°</text
        >

        <!-- Micro Telemetry Readout -->
        <text
            x="103"
            y="97"
            font-family="monospace"
            font-size="2.5"
            fill="currentColor"
            opacity="0.55">22.57°N 88.36°E</text
        >

        <!-- Outer diamond projection bounds -->
        <path
            d="M 100 20 L 180 100 L 100 180 L 20 100 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="0.3"
            stroke-dasharray="1 5"
            opacity="0.4"></path>

        <slot />
    </svg>
</div>
