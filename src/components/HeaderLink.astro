---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace((import.meta.env as any).BASE_URL, '');

const str = pathname.startsWith('/') ? pathname.substring(1) : pathname;
const slashIdx = str.indexOf('/');
const firstSegment = slashIdx !== -1 ? str.substring(0, slashIdx) : str;
const isActive = href === pathname || href === '/' + firstSegment;
---

<a
    href={href}
    data-astro-prefetch="hover"
    class:list={[
        className,
        'group relative rounded-full focus-visible:ring-2 focus-visible:ring-(--accent) focus-visible:ring-offset-2 focus-visible:outline-none dark:focus-visible:ring-offset-(--bg-main)',
        isActive
            ? 'active font-bold text-slate-900 bg-white shadow-xs border border-slate-200/80 dark:bg-white/10 dark:text-white dark:border-white/15 dark:shadow-[0_0_12px_rgba(255,255,255,0.06)]'
            : 'text-slate-600 hover:text-slate-900 hover:bg-white/50 dark:text-(--text-secondary) dark:hover:text-white dark:hover:bg-white/5',
    ]}
    aria-current={isActive ? 'page' : undefined}
    {...props}
>
    <slot />
</a>
