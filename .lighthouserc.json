{
    "ci": {
        "collect": {
            "numberOfRuns": 1,
            "startServerCommand": "npm run preview",
            "startServerReadyPattern": "http://localhost:4321",
            "startServerReadyTimeout": 30000,
            "url": [
                "http://localhost:4321/",
                "http://localhost:4321/personnel/",
                "http://localhost:4321/projects/",
                "http://localhost:4321/pedagogy/",
                "http://localhost:4321/transmissions/",
                "http://localhost:4321/projects/vellor/",
                "http://localhost:4321/projects/deltav-lab/",
                "http://localhost:4321/projects/fueldrop/",
                "http://localhost:4321/projects/the-infinite-intelligence/",
                "http://localhost:4321/projects/bill-express/",
                "http://localhost:4321/projects/glassbox/",
                "http://localhost:4321/transmissions/infinite-intelligence-why-and-what/",
                "http://localhost:4321/transmissions/my-ways-of-teaching/",
                "http://localhost:4321/transmissions/why-i-started-dbs-classes/",
                "http://localhost:4321/transmissions/vellor-why-and-what/"
            ],
            "settings": {
                "preset": "desktop",
                "chromeFlags": "--no-sandbox --headless --disable-gpu"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": ["warn", { "minScore": 0.85 }],
                "categories:accessibility": ["error", { "minScore": 0.9 }],
                "categories:best-practices": ["warn", { "minScore": 0.9 }],
                "categories:seo": ["error", { "minScore": 0.9 }]
            }
        }
    }
}
